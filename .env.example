# Beystech ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun (lokal geliştirme).
# Vercel'de bu değişkenler proje ayarlarından (Settings → Environment Variables) girilir.

# Admin panel parolası (girilmezse varsayılan: beystech2025)
ADMIN_PASSWORD=

# Upstash Redis (Vercel Marketplace → Upstash for Redis entegrasyonu bunları otomatik ekler).
# Boş bırakılırsa içerik yerel data/content.json dosyasından okunur/yazılır (sadece lokal).
KV_REST_API_URL=
KV_REST_API_TOKEN=
